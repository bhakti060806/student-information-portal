<%- include("partials/header", { title, portalName }) %>
<section class="hero">
  <p class="eyebrow">WEB TECHNOLOGY · PRACTICAL 5</p>
  <h1>Student Information Portal</h1>
  <p>Manage student records with a clean interface and server-side validation.</p>
  <a class="button" href="/students/new">Register a student</a>
</section>
<section class="stats">
  <article class="stat-card"><span>Total students</span><strong><%= students.length %></strong></article>
  <article class="stat-card"><span>Framework</span><strong>Express.js</strong></article>
  <article class="stat-card"><span>Validation</span><strong>Server-side</strong></article>
</section>
<section class="section-heading">
  <div><p class="eyebrow">DIRECTORY</p><h2>Recently added students</h2></div>
  <a class="text-link" href="/students">View all →</a>
</section>
<div class="student-grid">
  <% students.slice(-3).reverse().forEach(student => { %>
    <a class="student-card" href="/students/<%= student.id %>">
      <div class="avatar"><%= student.name.charAt(0).toUpperCase() %></div>
      <div><h3><%= student.name %></h3><p><%= student.department %></p><small><%= student.year %> · PRN <%= student.prn %></small></div>
      <span class="arrow">↗</span>
    </a>
  <% }) %>
</div>
<%- include("partials/footer") %>
