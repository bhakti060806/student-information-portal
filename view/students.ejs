<%- include("partials/header", { title, portalName }) %>
<section class="page-heading">
  <div><p class="eyebrow">DIRECTORY</p><h1>All Students</h1><p class="muted">Browse the student records currently stored in the portal.</p></div>
  <a class="button" href="/students/new">+ Add Student</a>
</section>
<% if (typeof query !== "undefined" && query.added) { %><div class="success">Student registered successfully.</div><% } %>
<% if (students.length === 0) { %>
  <div class="empty-state"><h2>No students yet</h2><p>Add the first student to get started.</p><a class="button" href="/students/new">Add student</a></div>
<% } else { %>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>PRN</th><th>Email</th><th>Department</th><th>Year</th><th>Details</th></tr></thead><tbody>
<% students.forEach(student => { %><tr><td><strong><%= student.name %></strong></td><td><%= student.prn %></td><td><%= student.email %></td><td><%= student.department %></td><td><span class="pill"><%= student.year %></span></td><td><a class="text-link" href="/students/<%= student.id %>">View →</a></td></tr><% }) %>
</tbody></table></div>
<% } %>
<%- include("partials/footer") %>
