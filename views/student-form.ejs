<%- include("partials/header", { title, portalName }) %>
<section class="page-heading"><div><p class="eyebrow">REGISTRATION</p><h1>Add a student</h1><p class="muted">All fields are validated on the server before saving.</p></div></section>
<% if (errors && errors.length) { %>
<div class="error-box" role="alert"><strong>Please correct the following:</strong><ul><% errors.forEach(error => { %><li><%= error.msg %></li><% }) %></ul></div>
<% } %>
<form class="form-card" action="/students" method="POST">
  <div class="form-grid">
    <label>Full name<input name="name" value="<%= form.name || '' %>" placeholder="e.g. Aditi Sharma" required maxlength="60"></label>
    <label>PRN / Roll number<input name="prn" value="<%= form.prn || '' %>" placeholder="e.g. 230123" required></label>
    <label>Email address<input type="email" name="email" value="<%= form.email || '' %>" placeholder="student@example.com" required></label>
    <label>Department<select name="department" required><option value="">Choose department</option><% ["Computer Engineering","Information Technology","AI & Data Science","Electronics & Telecommunication","Mechanical Engineering","Civil Engineering"].forEach(d => { %><option value="<%= d %>" <%= form.department === d ? "selected" : "" %>><%= d %></option><% }) %></select></label>
    <label>Academic year<select name="year" required><option value="">Choose year</option><% ["FY","SY","TY","Final Year"].forEach(y => { %><option value="<%= y %>" <%= form.year === y ? "selected" : "" %>><%= y %></option><% }) %></select></label>
  </div>
  <div class="form-actions"><a class="button button-light" href="/students">Cancel</a><button class="button" type="submit">Save student</button></div>
  <p class="form-note">PRN and email must be unique. Invalid submissions will be rejected by the server.</p>
</form>
<%- include("partials/footer") %>
